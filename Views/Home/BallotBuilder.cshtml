@model IEnumerable<municipal_election_web.Models.Candidate>
@{
    ViewData["Title"] = "Ballot Builder";
}

<!-- Import html2pdf to handle the client-side PDF generation -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Ballot Builder</h1>
        @if (Model.Any())
        {
            <button onclick="downloadPDF()" class="btn btn-outline-primary rounded-pill px-4 fw-semibold shadow-sm d-print-none">
                <i class="bi bi-file-earmark-pdf me-2"></i> Download PDF
            </button>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-light rounded border border-0 shadow-sm">
            <h4 class="text-muted">Your list is currently empty.</h4>
            <p>Browse the candidate directory to save candidates to your guide.</p>
            <a asp-controller="Candidates" asp-action="CandidatesBrowser" class="btn btn-primary mt-2">Browse Candidates</a>
        </div>
    }
    else
    {
        <div id="pdf-content">
            <div id="pdf-header" style="display: none; margin-bottom: 20px;">
                <h2 style="color: #1e2c49; font-weight: bold;">My Ballot Guide</h2>
                <p>Generated on @DateTime.Now.ToString("MMMM dd, yyyy")</p>
                <hr />
            </div>

            <div class="row g-4">
                @foreach (var candidate in Model)
                {
                    <div class="col-md-6 col-lg-4" id="candidate-card-@candidate.CandidateId">
                        <div class="card h-100 shadow-sm border-0 rounded-3">
                            <div class="row g-0 h-100">
                                <div class="col-4 pdf-hide d-print-none">
                                    @if (!string.IsNullOrEmpty(candidate.PhotoUrl))
                                    {
                                        <img src="@candidate.PhotoUrl" class="img-fluid rounded-start h-100" alt="@candidate.Name" style="object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="bg-secondary h-100 d-flex align-items-center justify-content-center rounded-start">
                                            <span class="text-white small">No Photo</span>
                                        </div>
                                    }
                                </div>
                                
                                <div class="col-8" id="text-col-@candidate.CandidateId">
                                    <div class="card-body d-flex flex-column h-100">
                                        <h5 class="card-title fw-bold mb-1">@candidate.Name</h5>
                                        <h6 class="card-subtitle mb-2 text-primary">@candidate.Position?.Name</h6>
                                        <span class="badge bg-dark mb-2 align-self-start">@candidate.Municipality?.Name</span>
                                        
                                        <p class="card-text small text-muted mt-2 mb-3">
                                            @candidate.Biography
                                        </p>
                                        
                                        <div class="mt-auto pdf-hide d-print-none">
                                            <button onclick="removeCandidate(@candidate.CandidateId)" class="btn btn-sm btn-light text-danger border rounded-pill w-100 fw-bold shadow-sm">
                                                <i class="bi bi-trash3 me-1"></i> Remove
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function removeCandidate(id) {
            fetch(`/Home/ToggleSavedCandidate?candidateId=${id}`, { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    if (!data.isSaved) {
                        const card = document.getElementById(`candidate-card-${id}`);
                        
                        card.style.transition = "opacity 0.3s ease, transform 0.3s ease";
                        card.style.opacity = "0";
                        card.style.transform = "scale(0.95)";
                        
                        setTimeout(() => {
                            card.remove();
                            if (document.querySelectorAll('[id^="candidate-card-"]').length === 0) {
                                location.reload(); 
                            }
                        }, 300);
                    }
                })
                .catch(err => console.error('Error removing candidate:', err));
        }

        function downloadPDF() {
            const element = document.getElementById('pdf-content');
            const header = document.getElementById('pdf-header');
            
            const hideElements = document.querySelectorAll('.pdf-hide');
            const textColumns = document.querySelectorAll('[id^="text-col-"]');

            header.style.display = 'block';
            hideElements.forEach(el => el.style.display = 'none');
            textColumns.forEach(col => {
                col.classList.remove('col-8');
                col.classList.add('col-12');
            });

            // Configure the PDF output
            const opt = {
                margin:       0.5,
                filename:     'My_Ballot_Guide.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true },
                jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' }
            };

            html2pdf().set(opt).from(element).save().then(() => {
                header.style.display = 'none';
                hideElements.forEach(el => el.style.display = 'block');
                
                textColumns.forEach(col => {
                    col.classList.remove('col-12');
                    col.classList.add('col-8');
                });
            });
        }
    </script>
}