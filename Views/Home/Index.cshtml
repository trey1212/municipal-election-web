@{
    ViewData["Title"] = "Home - BC Ballot Builder";
}

<div class="container py-5">
    <div class="p-5 bg-light rounded-4 shadow-sm">
        <div class="container-fluid py-2">
            <h1 class="display-4 fw-bold mb-3">Welcome to the BC Ballot Builder</h1>
            <p class="fs-5 mb-4" style="color: #2e7d32; max-width: 800px; line-height: 1.6;">
                The BC Ballot Builder is a voting guide that provides information on the municipalities
                in British Columbia. You can view municipalities, their candidates, and create a list of candidates
                to refer back to when you are ready to vote.
            </p>
            
            <div class="p-4 bg-white rounded-4 shadow-sm border">
                <partial name="_PositionDescriptions" />
            </div>
        </div>
    </div>
</div>