@model IEnumerable<municipal_election_web.Models.Candidate>
@{
    ViewData["Title"] = "Candidate Directory";
}

<div class="container py-5">
    <!-- Removed text-dark so it inherits your global Montserrat blue color -->
    <h1 class="mb-4 fw-bold">Candidate Directory</h1>

    <!-- Modern Filter Form matching the homepage hero section -->
    <form method="get" class="row g-3 mb-5 bg-light p-4 rounded-4 shadow-sm border-0">
        <div class="col-md-4">
            <label class="form-label fw-bold">Filter by Municipality</label>
            <select name="municipalityId" class="form-select rounded-pill" asp-items="ViewBag.Municipalities">
                <option value="">-- All Municipalities --</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-bold">Filter by Position</label>
            <select name="positionId" class="form-select rounded-pill" asp-items="ViewBag.Positions">
                <option value="">-- All Positions --</option>
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary rounded-pill me-2 px-4">Apply Filters</button>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Clear</a>
        </div>
    </form>

    <!-- Clean List Layout -->
    <div class="d-flex flex-column gap-3">
        @foreach (var candidate in Model)
        {
            <!-- Flex row displaying only Name, Position, City, and Button -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center p-4 bg-white rounded-4 shadow-sm modern-list-row border-0">
                
                <!-- Name and Position -->
                <div class="d-flex flex-column mb-3 mb-md-0" style="min-width: 250px;">
                    <h3 class="h5 fw-bold mb-1">@candidate.Name</h3>
                    <span class="fw-semibold">@candidate.Position?.Name</span>
                </div>
                
                <!-- City Badge -->
                <div class="mb-4 mb-md-0 text-md-center flex-grow-1">
                    <span class="badge bg-light border rounded-pill px-4 py-2 fs-6 fw-normal shadow-sm" style="color: #2e7d32;">
                        @candidate.Municipality?.Name
                    </span>
                </div>
                
                <!-- Profile Button -->
                <div class="text-md-end" style="min-width: 180px;">
                    <a asp-controller="Home" asp-action="CandidateDetails" asp-route-id="@candidate.CandidateId" class="btn btn-outline-primary rounded-pill px-4 w-100 fw-semibold">
                        View Profile
                    </a>
                </div>
                
            </div>
        }

        @if (!Model.Any())
        {
            <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                <p class="mt-3 fs-5">No candidates found matching your criteria.</p>
            </div>
        }
    </div>
</div>