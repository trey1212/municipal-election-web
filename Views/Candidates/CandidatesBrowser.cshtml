@model IEnumerable<municipal_election_web.Models.Candidate>
@{
    ViewData["Title"] = "Candidate Directory";
}

<div class="container py-5">
    <h1 class="mb-4 fw-bold text-dark">Candidate Directory</h1>

    <!-- Filter Form -->
    <form method="get" class="row g-3 mb-5 bg-light p-4 rounded shadow-sm border-0">
        <div class="col-md-4">
            <label class="form-label fw-bold">Filter by Municipality</label>
            <select name="municipalityId" class="form-select" asp-items="ViewBag.Municipalities">
                <option value="">-- All Municipalities --</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-bold">Filter by Position</label>
            <select name="positionId" class="form-select" asp-items="ViewBag.Positions">
                <option value="">-- All Positions --</option>
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary me-2 px-4">Apply Filters</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>

    <!-- Candidates Grid -->
    <div class="row g-4">
        @foreach (var candidate in Model)
        {
            <div class="col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm border-0 rounded-3">
                    @if (!string.IsNullOrEmpty(candidate.PhotoUrl))
                    {
                        <img src="@candidate.PhotoUrl" class="card-img-top" alt="@candidate.Name" style="height: 250px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 250px;">
                            <span class="text-white small">No Photo</span>
                        </div>
                    }
                    <!-- Added d-flex flex-column to push the button to the bottom -->
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold mb-1">@candidate.Name</h5>
                        <h6 class="card-subtitle mb-3 text-primary">@candidate.Position?.Name</h6>
                        <span class="badge bg-dark mb-3 w-50">@candidate.Municipality?.Name</span>
                        
                        <p class="card-text small text-muted" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            @candidate.Biography
                        </p>
                        
                        <!-- The View Profile Button using mt-auto -->
                        <div class="mt-auto pt-3">
                            <a asp-controller="Home" asp-action="CandidateDetails" asp-route-id="@candidate.CandidateId" class="btn btn-sm btn-primary w-100">
                                View Full Profile
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="col-12 text-center text-muted py-5">
                <i class="bi bi-search fs-1"></i>
                <p class="mt-3 fs-5">No candidates found matching your criteria.</p>
            </div>
        }
    </div>
</div>