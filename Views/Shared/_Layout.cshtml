<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/municipal_election_web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark custom-nav shadow-sm py-3 mb-5">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4 tracking-tight" asp-area="" asp-controller="Home" asp-action="Index">
                    BC Ballot Builder
                </a>
                <button class="navbar-toggler border-0 px-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between mt-3 mt-lg-0">
                    <ul class="navbar-nav flex-grow-1 justify-content-center align-items-center gap-4">
                        <li class="nav-item w-100 w-lg-auto text-center">
                            <a class="btn border-0 text-white rounded-pill px-4 w-100 nav-pill-btn" asp-area="" asp-controller="Municipalities" asp-action="MunicipalityBrowser">Municipalities</a>
                        </li>
                        <li class="nav-item w-100 w-lg-auto text-center">
                            <a class="btn border-0 text-white rounded-pill px-4 w-100 nav-pill-btn" asp-area="" asp-controller="Candidates" asp-action="CandidatesBrowser">Candidates</a>
                        </li>
                        <li class="nav-item w-100 w-lg-auto text-center">
                            <a class="btn border-0 text-white rounded-pill px-4 w-100 nav-pill-btn" asp-area="" asp-controller="Home" asp-action="BallotBuilder">Ballot Builder</a>
                        </li>
                    </ul>
                    <div class="d-flex justify-content-center mt-3 mt-lg-0 ms-lg-5">
                        <a class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm text-white" href="#" data-bs-toggle="offcanvas" data-bs-target="#votingCartSidebar" aria-controls="votingCartSidebar">
                            <i class="bi bi-card-checklist me-2"></i> View My List
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Offcanvas Cart Sidebar -->
    <div class="offcanvas offcanvas-end shadow" tabindex="-1" id="votingCartSidebar" aria-labelledby="votingCartLabel">
        <div class="offcanvas-header border-bottom bg-light">
            <h5 class="offcanvas-title fw-bold" id="votingCartLabel">
                <i class="bi bi-card-list text-primary me-2"></i>My Candidates
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body" id="cartContentArea"></div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - BC Ballot Builder - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/votingCart.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
