@model IEnumerable<municipal_election_web.Models.Candidate>

@if (!Model.Any())
{
    <div class="text-center text-muted mt-5">
        <i class="bi bi-journal-x fs-1"></i>
        <p class="mt-2">Your voting guide is empty.</p>
    </div>
}
else
{
    <div class="list-group list-group-flush mb-3">
        @foreach (var candidate in Model)
        {
            <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    @if (!string.IsNullOrEmpty(candidate.PhotoUrl))
                    {
                        <img src="@candidate.PhotoUrl" class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="bi bi-person text-white"></i>
                        </div>
                    }
                    <div>
                        <h6 class="mb-0 fw-bold">@candidate.Name</h6>
                        <small class="text-muted">@candidate.Position?.Name</small>
                    </div>
                </div>
                <button onclick="toggleGlobalCandidate(@candidate.CandidateId, false)" class="btn btn-sm btn-outline-danger border-0">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        }
    </div>
    <a asp-controller="Home" asp-action="BallotBuilder" class="btn btn-primary w-100">Review Full Guide</a>
}