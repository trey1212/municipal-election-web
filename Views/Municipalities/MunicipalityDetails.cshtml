@model municipal_election_web.Models.Municipality
@{
    ViewData["Title"] = Model.Name + " Candidates";
}

<div class="container py-5">
    <!-- Municipality Header -->
    <div class="d-flex justify-content-between align-items-center mb-5 pb-3 border-bottom">
        <div class="d-flex align-items-center">
            @if (!string.IsNullOrEmpty(Model.LogoUrl))
            {
                <img src="@Model.LogoUrl" alt="@Model.Name Logo" class="me-4 rounded-4 shadow-sm" style="height: 80px; object-fit: contain;" />
            }
            <div>
                <h1 class="fw-bold mb-1">@Model.Name Election</h1>
                <p class="text-muted mb-0 fw-semibold">
                    <i class="bi bi-calendar-event me-2"></i>@Model.ElectionDate.ToString("MMMM dd, yyyy")
                </p>
            </div>
        </div>
        <div>
            <a asp-controller="Municipalities" asp-action="MunicipalityBrowser" class="btn btn-outline-secondary rounded-pill px-4">
                Back to Municipalities
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <p class="lead mb-5 text-secondary" style="max-width: 800px;">@Model.Description</p>
    }

    <!-- Candidates Grid -->
    @if (Model.Candidates.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var candidate in Model.Candidates)
            {
                <div class="col">
                    <div class="card shadow-sm border-0 rounded-4 h-100 overflow-hidden">
                        @if (!string.IsNullOrEmpty(candidate.PhotoUrl))
                        {
                            <img src="@candidate.PhotoUrl" class="card-img-top" alt="@candidate.Name" style="height: 320px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center border-bottom" style="height: 320px;">
                                <span class="text-muted"><i class="bi bi-person text-secondary" style="font-size: 3rem;"></i></span>
                            </div>
                        }
                        
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h4 class="card-title fw-bold mb-0">@candidate.Name</h4>
                                <span class="badge bg-dark rounded-pill px-3 py-2">@candidate.Position?.Name</span>
                            </div>
                            
                            <p class="card-text text-muted mt-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.6;">
                                @candidate.Biography
                            </p>
                            
                            <a asp-controller="Home" asp-action="CandidateDetails" asp-route-id="@candidate.CandidateId" class="btn btn-primary rounded-pill w-100 fw-semibold py-2 mt-4">
                                View Profile
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-light border rounded-4 text-center py-5 shadow-sm">
            <h5 class="fw-bold mb-2">No Candidates Found</h5>
            <p class="text-muted mb-0">There are currently no candidates registered for the @Model.Name election.</p>
        </div>
    }
</div>