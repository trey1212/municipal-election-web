@model municipal_election_web.Areas.Admin.Models.DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-5">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-5 pb-3 border-bottom">
        <div>
            <h1 class="h2 mb-1 fw-bold text-dark">Administration Portal</h1>
            <p class="text-muted mb-0">
                Logged in as
                @if (Model.IsSuperAdmin)
                {
                    <span class="badge bg-danger ms-1">Super Admin</span>
                }
                else
                {
                    <span class="badge bg-primary ms-1">Municipality Admin (@Model.MunicipalityName)</span>
                }
            </p>
        </div>
        <div>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> View Public Site
            </a>

            <form asp-area="Admin" asp-controller="Dashboard" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-outline-danger">Log Out</button>
            </form>
        </div>
    </div>

    <!-- Municipalities Table (Super Admin Only) -->
    @if (Model.IsSuperAdmin)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="fw-bold m-0">Municipalities</h3>
            <a asp-area="Admin" asp-controller="Municipalities" asp-action="Create" class="btn btn-primary btn-sm">Add
                Municipality</a>
            </div>
        
            <div class="card shadow-sm border-0 mb-5">
                <div class="card-body p-0 table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Logo</th>
                                <th>Name</th>
                                <th>Province</th>
                                <th>Election Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var city in Model.Municipalities)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(city.LogoUrl))
                                        {
                                            <img src="@city.LogoUrl" alt="Logo" style="height: 30px; object-fit: contain;" />
                                        }
                                    </td>
                                    <td class="fw-bold">@city.Name</td>
                                    <td>@city.Province</td>
                                    <td>@city.ElectionDate.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-controller="Municipalities" asp-action="Edit" asp-route-id="@city.MunicipalityId"
                                               class="btn btn-outline-primary">View / Edit</a>
                                            <a asp-controller="Municipalities" asp-action="Delete"
                                               asp-route-id="@city.MunicipalityId" class="btn btn-outline-danger">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- Candidates Table -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="fw-bold m-0">Candidate Roster</h3>
            <a asp-area="Admin" asp-controller="Candidates" asp-action="Create" class="btn btn-success btn-sm">Add
                Candidate</a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-0 table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Photo</th>
                                <th>Name</th>
                                <th>Position</th>
                                @if (Model.IsSuperAdmin)
                                {
                                    <th>Municipality</th>
                                }
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var candidate in Model.Candidates)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(candidate.PhotoUrl))
                                        {
                                            <img src="@candidate.PhotoUrl" alt="Photo" class="rounded-circle"
                                                 style="height: 40px; width: 40px; object-fit: cover;" />
                                        }
                                    </td>
                                    <td class="fw-bold">@candidate.Name</td>
                                    <td>@candidate.Position?.Name</td>
                            
                                    @if (Model.IsSuperAdmin)
                                    {
                                        <td><span class="badge bg-secondary">@candidate.Municipality?.Name</span></td>
                                    }
                            
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-controller="Candidates" asp-action="Edit" asp-route-id="@candidate.CandidateId"
                                               class="btn btn-outline-primary">View / Edit</a>
                                            <a asp-controller="Candidates" asp-action="Delete" asp-route-id="@candidate.CandidateId"
                                               class="btn btn-outline-danger">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>