@model municipal_election_web.Areas.Admin.Models.DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<!-- Dashboard Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 pb-3 border-bottom" style="border-color: #1e293b !important;">
    <div>
        <h1 class="h3 fw-bold mb-1 text-slate-100">Dashboard Overview</h1>
        <p class="text-slate-400 mb-0">
            Logged in as:
            @if (Model.IsSuperAdmin)
            {
                <span class="badge rounded-pill bg-danger ms-2 px-3 fw-normal">Super Admin</span>
            }
            else
            {
                <span class="badge rounded-pill bg-primary ms-2 px-3 fw-normal">@Model.MunicipalityName Admin</span>
            }
        </p>
    </div>
    <div class="mt-3 mt-md-0">
        <form asp-area="Admin" asp-controller="Dashboard" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-outline-danger rounded-pill px-4 shadow-sm">
                <i class="bi bi-box-arrow-right me-2"></i> Sign Out
            </button>
        </form>
    </div>
</div>

<!-- Quick Stats Row -->
<div class="row g-4 mb-5">
    @if (Model.IsSuperAdmin)
    {
        <div class="col-md-6 col-lg-3">
            <div class="dark-card rounded-4 h-100 p-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="text-slate-400 fw-semibold mb-0">Total Municipalities</h6>
                        <div class="bg-primary bg-opacity-25 p-2 rounded-3">
                            <i class="bi bi-building text-primary fs-5"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold mb-0 text-slate-100">@Model.Municipalities.Count()</h2>
                </div>
            </div>
        </div>
    }
    <div class="col-md-6 col-lg-3">
        <div class="dark-card rounded-4 h-100 p-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="text-slate-400 fw-semibold mb-0">Total Candidates</h6>
                    <div class="bg-success bg-opacity-25 p-2 rounded-3">
                        <i class="bi bi-people text-success fs-5"></i>
                    </div>
                </div>
                <h2 class="fw-bold mb-0 text-slate-100">@Model.Candidates.Count()</h2>
            </div>
        </div>
    </div>
</div>

<!-- Municipalities Table (Super Admin Only) -->
@if (Model.IsSuperAdmin)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold m-0 text-slate-100">Municipalities</h5>
        <a asp-area="Admin" asp-controller="Municipalities" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm fw-semibold">
            <i class="bi bi-plus-lg me-1"></i> Add Municipality
        </a>
    </div>

    <div class="dark-card rounded-4 mb-5 overflow-hidden">
        <div class="card-body p-0 table-responsive">
            <table class="table dark-table align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Logo</th>
                        <th>Name</th>
                        <th>Province</th>
                        <th>Election Date</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var city in Model.Municipalities)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                @if (!string.IsNullOrEmpty(city.LogoUrl))
                                {
                                    <img src="@city.LogoUrl" alt="Logo" class="rounded-3 shadow-sm bg-white" style="height: 40px; padding: 2px; object-fit: contain;" />
                                }
                            </td>
                            <td class="fw-bold py-3">@city.Name</td>
                            <td class="py-3 text-slate-300">@city.Province</td>
                            <td class="py-3 text-slate-300">@city.ElectionDate.ToString("MMM dd, yyyy")</td>
                            <td class="text-end pe-4 py-3">
                                <a asp-controller="Municipalities" asp-action="Edit" asp-route-id="@city.MunicipalityId" class="btn btn-sm btn-outline-light rounded-pill px-3 shadow-sm me-2">
                                    Edit
                                </a>
                                <form asp-controller="Municipalities" asp-action="Delete" asp-route-id="@city.MunicipalityId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to completely delete @city.Name?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Candidates Table -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold m-0 text-slate-100">Candidate Roster</h5>
    <a asp-area="Admin" asp-controller="Candidates" asp-action="Create" class="btn btn-success btn-sm rounded-pill px-4 shadow-sm fw-semibold">
        <i class="bi bi-person-plus me-1"></i> Add Candidate
    </a>
</div>

<div class="dark-card rounded-4 overflow-hidden mb-5">
    <div class="card-body p-0 table-responsive">
        <table class="table dark-table align-middle">
            <thead>
                <tr>
                    <th class="ps-4">Photo</th>
                    <th>Name</th>
                    <th>Position</th>
                    @if (Model.IsSuperAdmin)
                    {
                        <th>Municipality</th>
                    }
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var candidate in Model.Candidates)
                {
                    <tr>
                        <td class="ps-4 py-3">
                            @if (!string.IsNullOrEmpty(candidate.PhotoUrl))
                            {
                                <img src="@candidate.PhotoUrl" alt="Photo" class="rounded-circle shadow-sm" style="height: 45px; width: 45px; object-fit: cover;" />
                            }
                        </td>
                        <td class="fw-bold py-3">@candidate.Name</td>
                        <td class="py-3">
                            <span class="badge rounded-pill px-3 fw-normal border-0" style="background-color: #334155; color: #cbd5e1;">@candidate.Position?.Name</span>
                        </td>
                
                        @if (Model.IsSuperAdmin)
                        {
                            <td class="py-3 text-slate-300">@candidate.Municipality?.Name</td>
                        }
                
                        <td class="text-end pe-4 py-3">
                            <a asp-controller="Candidates" asp-action="Edit" asp-route-id="@candidate.CandidateId" class="btn btn-sm btn-outline-light rounded-pill px-3 shadow-sm me-2">
                                Edit
                            </a>
                            <form asp-controller="Candidates" asp-action="Delete" asp-route-id="@candidate.CandidateId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete @candidate.Name?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>