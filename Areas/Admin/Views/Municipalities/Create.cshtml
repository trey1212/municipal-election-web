@model municipal_election_web.Areas.Admin.Models.CreateMunicipality
@{
    ViewData["Title"] = "Add Municipality";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Add New Municipality</h2>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
    <hr />

    <div class="row">
        <div class="col-md-7">
            <form asp-action="Create" enctype="multipart/form-data">
                
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Province" class="form-label fw-bold"></label>
                    <input asp-for="Province" class="form-control" />
                    <span asp-validation-for="Province" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ElectionDate" class="form-label fw-bold">Election Date</label>
                    <input asp-for="ElectionDate" type="date" class="form-control" />
                    <span asp-validation-for="ElectionDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="LogoUpload" class="form-label fw-bold">Municipality Logo</label>
                    <input asp-for="LogoUpload" type="file" class="form-control" accept="image/*" />
                    <span asp-validation-for="LogoUpload" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary px-4">Create Municipality</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}