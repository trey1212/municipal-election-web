@model municipal_election_web.Areas.Admin.Models.CreateMunicipality
@{
    ViewData["Title"] = "Add Municipality";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h3 fw-bold text-slate-100 mb-0">Add New Municipality</h2>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-light rounded-pill btn-sm px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>

        <div class="dark-card rounded-4 mb-5">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" enctype="multipart/form-data">
                    
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-bold text-slate-300"></label>
                        <input asp-for="Name" class="form-control form-control-lg" placeholder="Municipality name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="Province" class="form-label fw-bold text-slate-300"></label>
                            <input asp-for="Province" class="form-control" placeholder="e.g. British Columbia" />
                            <span asp-validation-for="Province" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mt-4 mt-md-0">
                            <label asp-for="ElectionDate" class="form-label fw-bold text-slate-300">Election Date</label>
                            <input asp-for="ElectionDate" type="date" class="form-control" />
                            <span asp-validation-for="ElectionDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-bold text-slate-300"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter municipality details..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-5">
                        <label asp-for="LogoUpload" class="form-label fw-bold text-slate-300">Municipality Logo</label>
                        <input asp-for="LogoUpload" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="LogoUpload" class="text-danger small"></span>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-success rounded-pill px-5 py-2 fw-bold shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> Create Municipality
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}