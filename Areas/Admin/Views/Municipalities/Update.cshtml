@model municipal_election_web.Areas.Admin.Models.UpdateMunicipality
@{
    ViewData["Title"] = "Edit Municipality";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h3 fw-bold text-slate-100 mb-0">Edit: @Model.Name</h2>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-light rounded-pill btn-sm px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>

        <div class="dark-card rounded-4 mb-5">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" enctype="multipart/form-data">
                    <input type="hidden" asp-for="MunicipalityId" />
                    <input type="hidden" asp-for="ExistingLogoUrl" />

                    <div class="text-center mb-5 pb-4 border-bottom" style="border-color: #334155 !important;">
                        <label class="form-label text-slate-400 fw-bold d-block mb-3">Current Logo</label>
                        @if (!string.IsNullOrEmpty(Model.ExistingLogoUrl))
                        {
                            <img src="@Model.ExistingLogoUrl" alt="Current Logo" class="rounded-3 shadow-sm bg-white"
                                 style="height: 120px; padding: 10px; object-fit: contain; border: 1px solid #334155;" />
                        }
                        else
                        {
                            <div class="d-inline-flex align-items-center justify-content-center rounded-3"
                                 style="height: 120px; width: 120px; background-color: #0f172a; border: 2px dashed #334155;">
                                <i class="bi bi-building text-slate-400" style="font-size: 3rem;"></i>
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-bold text-slate-300"></label>
                        <input asp-for="Name" class="form-control form-control-lg" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="Province" class="form-label fw-bold text-slate-300"></label>
                            <input asp-for="Province" class="form-control" />
                            <span asp-validation-for="Province" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mt-4 mt-md-0">
                            <label asp-for="ElectionDate" class="form-label fw-bold text-slate-300">Election Date</label>
                            <input asp-for="ElectionDate" type="date" class="form-control" />
                            <span asp-validation-for="ElectionDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-bold text-slate-300"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-5">
                        <label asp-for="NewLogoUpload" class="form-label fw-bold text-slate-300">Upload New Logo</label>
                        <input asp-for="NewLogoUpload" type="file" class="form-control" accept="image/*" />
                        <div class="form-text text-slate-400 mt-2"><i class="bi bi-info-circle me-1"></i> Leave this blank to keep the current logo.</div>
                        <span asp-validation-for="NewLogoUpload" class="text-danger small"></span>
                    </div>

                    <div class="text-end">
                        <button type="submit" id="saveBtn" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm" disabled>
                            <i class="bi bi-save me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.querySelector("form");
            const saveBtn = document.getElementById("saveBtn");
            const initialValues = {};
            const elements = form.querySelectorAll("input, textarea, select");
            
            elements.forEach(el => {
                if (el.name) {
                    initialValues[el.name] = el.type === "file" ? "" : el.value;
                }
            });

            function checkChanges() {
                let hasChanged = false;
                elements.forEach(el => {
                    if (el.name) {
                        if (el.type === "file") {
                            if (el.files.length > 0) hasChanged = true;
                        } else {
                            if (el.value !== initialValues[el.name]) hasChanged = true;
                        }
                    }
                });
                saveBtn.disabled = !hasChanged;
            }

            elements.forEach(el => {
                el.addEventListener("input", checkChanges);
                el.addEventListener("change", checkChanges);
            });
        });
    </script>
}