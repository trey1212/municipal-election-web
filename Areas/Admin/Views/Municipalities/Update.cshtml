@model municipal_election_web.Areas.Admin.Models.UpdateMunicipality

@{
    ViewData["Title"] = "View / Edit Municipality";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@Model.Name Details</h2>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>
    <hr />

    <div class="row">
        <div class="col-md-7">
            <form asp-action="Edit" enctype="multipart/form-data">
                <input type="hidden" asp-for="MunicipalityId" />
                <input type="hidden" asp-for="ExistingLogoUrl" />

                <div class="mb-3">
                    <label class="form-label text-muted fw-bold">Current Logo</label>
                    <div class="mb-3">
                        @if (!string.IsNullOrEmpty(Model.ExistingLogoUrl))
                        {
                            <img src="@Model.ExistingLogoUrl" alt="Current Logo" class="img-thumbnail"
                                 style="max-height: 150px;" />
                        }
                        else
                        {
                            <span class="text-muted fst-italic">No logo on file.</span>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Province" class="form-label fw-bold"></label>
                    <input asp-for="Province" class="form-control" />
                    <span asp-validation-for="Province" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ElectionDate" class="form-label fw-bold">Election Date</label>
                    <input asp-for="ElectionDate" type="date" class="form-control" />
                    <span asp-validation-for="ElectionDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="NewLogoUpload" class="form-label fw-bold">Upload New Logo (Optional)</label>
                    <input asp-for="NewLogoUpload" type="file" class="form-control" accept="image/*" />
                    <div class="form-text">Leave this blank to keep the current logo.</div>
                    <span asp-validation-for="NewLogoUpload" class="text-danger"></span>
                </div>

                <button type="submit" id="saveBtn" class="btn btn-primary px-4" disabled>Save Changes</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.querySelector("form");
            const saveBtn = document.getElementById("saveBtn");
            
            // 1. Store the initial values of all form inputs
            const initialValues = {};
            const elements = form.querySelectorAll("input, textarea, select");
            
            elements.forEach(el => {
                if (el.name) {
                    // File inputs are empty on load, otherwise save the text/date value
                    initialValues[el.name] = el.type === "file" ? "" : el.value;
                }
            });

            // 2. Check for changes
            function checkChanges() {
                let hasChanged = false;
                
                elements.forEach(el => {
                    if (el.name) {
                        if (el.type === "file") {
                            // If a file was selected, a change occurred
                            if (el.files.length > 0) hasChanged = true;
                        } else {
                            // If current text/date doesn't match the original, a change occurred
                            if (el.value !== initialValues[el.name]) hasChanged = true;
                        }
                    }
                });

                // 3. Enable or disable the button based on changes
                saveBtn.disabled = !hasChanged;
            }

            // 4. Attach event listeners to trigger the check whenever the user types or clicks
            elements.forEach(el => {
                el.addEventListener("input", checkChanges);
                el.addEventListener("change", checkChanges);
            });
        });
    </script>
}