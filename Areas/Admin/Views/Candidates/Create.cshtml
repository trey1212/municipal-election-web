@model municipal_election_web.Areas.Admin.Models.CreateCandidate
@{
    ViewData["Title"] = "Add Candidate";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h3 fw-bold text-slate-100 mb-0">Add New Candidate</h2>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-light rounded-pill btn-sm px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>

        <div class="dark-card rounded-4 mb-5">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" enctype="multipart/form-data">
                    
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-bold text-slate-300"></label>
                        <input asp-for="Name" class="form-control form-control-lg" placeholder="Candidate's full name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="PositionId" class="form-label fw-bold text-slate-300">Position</label>
                            <select asp-for="PositionId" class="form-select" asp-items="ViewBag.Positions">
                                <option value="">-- Select a Position --</option>
                            </select>
                            <span asp-validation-for="PositionId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mt-4 mt-md-0">
                            <label asp-for="MunicipalityId" class="form-label fw-bold text-slate-300">Municipality</label>
                            <select asp-for="MunicipalityId" class="form-select" asp-items="ViewBag.Municipalities">
                                @if (User.IsInRole("SuperAdmin"))
                                {
                                    <option value="">-- Select a Municipality --</option>
                                }
                            </select>
                            <span asp-validation-for="MunicipalityId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Biography" class="form-label fw-bold text-slate-300"></label>
                        <textarea asp-for="Biography" class="form-control" rows="5" placeholder="Enter candidate background..."></textarea>
                        <span asp-validation-for="Biography" class="text-danger small"></span>
                    </div>

                    <div class="mb-5">
                        <label asp-for="PhotoUpload" class="form-label fw-bold text-slate-300">Candidate Photo</label>
                        <input asp-for="PhotoUpload" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="PhotoUpload" class="text-danger small"></span>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-success rounded-pill px-5 py-2 fw-bold shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> Register Candidate
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}