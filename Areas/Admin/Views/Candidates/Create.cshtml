@model municipal_election_web.Areas.Admin.Models.CreateCandidate
@{
    ViewData["Title"] = "Add Candidate";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Add New Candidate</h2>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>
    <hr />

    <div class="row">
        <div class="col-md-7">
            <!-- Ensure enctype is set so file uploads work properly -->
            <form asp-action="Create" enctype="multipart/form-data">
                
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PositionId" class="form-label fw-bold">Position</label>
                    <select asp-for="PositionId" class="form-select" asp-items="ViewBag.Positions">
                        <option value="">-- Select a Position --</option>
                    </select>
                    <span asp-validation-for="PositionId" class="text-danger"></span>
                </div>

                <!-- Only show the Municipality dropdown if the user is a SuperAdmin. -->
                <!-- The MunicipalityAdmin's dropdown will be locked to their single city by the controller -->
                <div class="mb-3">
                    <label asp-for="MunicipalityId" class="form-label fw-bold">Municipality</label>
                    <select asp-for="MunicipalityId" class="form-select" asp-items="ViewBag.Municipalities">
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <option value="">-- Select a Municipality --</option>
                        }
                    </select>
                    <span asp-validation-for="MunicipalityId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Biography" class="form-label fw-bold"></label>
                    <textarea asp-for="Biography" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Biography" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="PhotoUpload" class="form-label fw-bold">Candidate Photo</label>
                    <input asp-for="PhotoUpload" type="file" class="form-control" accept="image/*" />
                    <span asp-validation-for="PhotoUpload" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success px-4">Register Candidate</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}