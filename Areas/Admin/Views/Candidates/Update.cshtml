@model municipal_election_web.Areas.Admin.Models.UpdateCandidate
@{
    ViewData["Title"] = "Edit Candidate";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h3 fw-bold text-slate-100 mb-0">Edit: @Model.Name</h2>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-light rounded-pill btn-sm px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>

        <div class="dark-card rounded-4 mb-5">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" enctype="multipart/form-data">
                    <input type="hidden" asp-for="CandidateId" />
                    <input type="hidden" asp-for="ExistingPhotoUrl" />

                    <!-- Explicit border color matching the dark theme borders -->
                    <div class="text-center mb-5 pb-4 border-bottom" style="border-color: #334155 !important;">
                        <label class="form-label text-slate-400 fw-bold d-block mb-3">Current Photo</label>
                        @if (!string.IsNullOrEmpty(Model.ExistingPhotoUrl))
                        {
                            <img src="@Model.ExistingPhotoUrl" alt="Current Photo" class="rounded-circle shadow-sm"
                                 style="height: 150px; width: 150px; object-fit: cover; border: 4px solid #334155;" />
                        }
                        else
                        {
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle"
                                 style="height: 150px; width: 150px; background-color: #0f172a; border: 2px dashed #334155;">
                                <i class="bi bi-person text-slate-400" style="font-size: 4rem;"></i>
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-bold text-slate-300"></label>
                        <input asp-for="Name" class="form-control form-control-lg" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="PositionId" class="form-label fw-bold text-slate-300">Position</label>
                            <select asp-for="PositionId" class="form-select" asp-items="ViewBag.Positions"></select>
                            <span asp-validation-for="PositionId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mt-4 mt-md-0">
                            <label asp-for="MunicipalityId" class="form-label fw-bold text-slate-300">Municipality</label>
                            <select asp-for="MunicipalityId" class="form-select" asp-items="ViewBag.Municipalities"
                                    disabled="@(User.IsInRole("MunicipalityAdmin") ? "disabled" : null)">
                            </select>
                            
                            @if (User.IsInRole("MunicipalityAdmin"))
                            {
                                <input type="hidden" asp-for="MunicipalityId" />
                            }
                            <span asp-validation-for="MunicipalityId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Biography" class="form-label fw-bold text-slate-300"></label>
                        <textarea asp-for="Biography" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="Biography" class="text-danger small"></span>
                    </div>

                    <div class="mb-5">
                        <label asp-for="NewPhotoUpload" class="form-label fw-bold text-slate-300">Upload New Photo</label>
                        <input asp-for="NewPhotoUpload" type="file" class="form-control" accept="image/*" />
                        <div class="form-text text-slate-400 mt-2"><i class="bi bi-info-circle me-1"></i> Leave this blank to keep the current photo.</div>
                        <span asp-validation-for="NewPhotoUpload" class="text-danger small"></span>
                    </div>

                    <div class="text-end">
                        <button type="submit" id="saveBtn" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm" disabled>
                            <i class="bi bi-save me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.querySelector("form");
            const saveBtn = document.getElementById("saveBtn");
            const initialValues = {};
            const elements = form.querySelectorAll("input, textarea, select");
            
            elements.forEach(el => {
                if (el.name) {
                    initialValues[el.name] = el.type === "file" ? "" : el.value;
                }
            });

            function checkChanges() {
                let hasChanged = false;
                elements.forEach(el => {
                    if (el.name) {
                        if (el.type === "file") {
                            if (el.files.length > 0) hasChanged = true;
                        } else {
                            if (el.value !== initialValues[el.name]) hasChanged = true;
                        }
                    }
                });
                saveBtn.disabled = !hasChanged;
            }

            elements.forEach(el => {
                el.addEventListener("input", checkChanges);
                el.addEventListener("change", checkChanges);
            });
        });
    </script>
}